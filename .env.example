# Copy to .env (gitignored) on the machine that runs the daemon.

# ── Discord webhooks ───────────────────────────────────────────────────────
# Override discord.* in config.yaml. Keep real URLs here, never in config.yaml.
DISCORD_DROP_ALERTS=
DISCORD_QUEUE_LIVE=
DISCORD_CHECKOUT_SUCCESS=
DISCORD_CHECKOUT_FAIL=
DISCORD_ACTION_NEEDED=
DISCORD_DRAWINGS=
DISCORD_DISCOVERY=
DISCORD_CANCELLATIONS=
DISCORD_HEALTH=
# Your Discord user id — urgent alerts (your turn, through the queue) @mention you.
DISCORD_MENTION_USER_ID=
# Public dashboard URL, so Discord alerts link straight to Live view.
DASHBOARD_URL=

# ── Checkout secrets ───────────────────────────────────────────────────────
# Card security codes for the saved card on each retailer account.
# Retailers often ask for CVV at checkout even with a saved card.
TARGET_CVV=
BESTBUY_CVV=
WALMART_CVV=
COSTCO_CVV=
SAMSCLUB_CVV=
POKEMONCENTER_CVV=

# ── Checkout browser ───────────────────────────────────────────────────────
# Leave blank to use installed Google Chrome (recommended).
CHECKOUT_BROWSER_PATH=
# Optional residential proxy for checkout, e.g. http://user:pass@host:port
CHECKOUT_PROXY=

# ── Daemon API auth ────────────────────────────────────────────────────────
# Shared secret between the daemon and the dashboard. Set the SAME value as
# DAEMON_TOKEN in the frontend's env (Vercel). Strongly recommended now that
# the API can arm auto-checkout.
DAEMON_TOKEN=
